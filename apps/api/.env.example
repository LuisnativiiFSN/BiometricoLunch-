DATABASE_URL="sqlserver://SERVIDOR:PUERTO;database=NOMBRE_BASE;user=USUARIO;password=CONTRASENA;encrypt=true;trustServerCertificate=true"
DB_SERVER="SERVIDOR_O_IP"
DB_PORT="PUERTO_TCP"
DB_DATABASE="NOMBRE_BASE"
DB_USER="USUARIO_SQL"
DB_PASSWORD="CONTRASENA_SQL"
DB_ENCRYPT="true"
DB_TRUST_SERVER_CERTIFICATE="true"
DB_TLS_SERVER_NAME=""
PORT=3000
BIOMETRIC_ENCRYPTION_KEY=""
AUTH_JWT_SECRET="GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES"
WEB_ORIGIN="http://localhost:5173"
# Compatibilidad temporal: false permite kioscos existentes sin token.
# Cuando sea true, las rutas /api/kiosk y /api/biometrics exigen Bearer token.
KIOSK_AUTH_REQUIRED=false
KIOSK_MEAL_LEGACY_COMPATIBILITY=true
# Vigencia maxima del snapshot descargado por el kiosco (5 minutos a 24 horas).
BIOMETRIC_GALLERY_TTL_SECONDS=900
