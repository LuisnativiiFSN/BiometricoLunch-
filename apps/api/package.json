{
  "name": "@comedor/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:seed": "prisma db seed",
    "prisma:validate": "prisma validate",
    "test:integration": "pnpm build && node --test --test-concurrency=1 test/meals.integration.test.mjs test/auth.integration.test.mjs",
    "test:biometrics": "pnpm build && node --test --test-concurrency=1 test/biometrics.integration.test.mjs",
    "verify:matcher": "pnpm build && node test/verify-stored-enrollments.mjs",
    "phase4:data": "pnpm build && node test/phase4-acceptance-data.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.1",
    "@prisma/adapter-mssql": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/mssql": "^9.1.8",
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  }
}
